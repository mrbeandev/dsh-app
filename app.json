{
  "expo": {
    "name": "DSH Mobile",
    "scheme": "dsh-app",
    "slug": "dsh-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.mrbean.dshapp",
      "infoPlist": { "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true }, "NSLocalNetworkUsageDescription": "Connect to your DeepSeek Harness on your local network." }
    },
    "android": {
      "package": "dev.mrbean.dshapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ]
  }
}
